# LEARNMATE AI backend environment configuration
# Copy this file to `.env` and adjust the values for your local setup.

# Database — psycopg3 driver. Update user/password/host/db to match your local PostgreSQL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learnmate_db
DB_ECHO=false

# Security — generate a random secret for production!
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — list the frontend origins that should be allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Application
APP_NAME=LEARNMATE AI
APP_VERSION=0.1.0
DEBUG=true
